@page "/"
@using NcLotteryWebApp.Models
@using NcLotteryWebApp.Services.Factories


@inject LotteryFactory LotteryFactory

<div class="container text-center mt-5">
    <div class="card shadow-lg p-4 mx-auto" style="max-width: 500px; border-radius: 20px;">
        <h2 class="mb-4">🎰 NC Lottery Generator</h2>
        <p class="text-muted">Lottery Ticket Generator (North Carolina)</p>

        <!-- Buttons -->
        <div class="d-grid gap-3 my-4">
            <button class="btn btn-primary btn-lg p-3" @onclick='() => Generate("powerball")'>
                🔮 PowerBall
            </button>
            <button class="btn btn-success btn-lg p-3" @onclick='() => Generate("megamillions")'>
                💰 Mega Millions
            </button>
        </div>

        <!-- Outputting the result -->
        @if (result != null)
        {
            <div class="mt-4 animate__animated animate__fadeIn">
                <h4 class="text-secondary mb-3">Ticket for @result.LotteryName:</h4>
                <div class="d-flex justify-content-center align-items-center flex-wrap gap-2">

                    @foreach (var num in result.MainNumbers)
                    {
                        <div class="rounded-circle bg-light border border-success d-flex align-items-center justify-content-center text-success fw-bold fs-4 shadow-sm"
                             style="width: 55px; height: 55px;">
                            @num.ToString("D2")
                        </div>
                    }

                    <div class="fw-bold fs-3 mx-1 text-muted">|</div>

                    <!-- Bonus ball -->
                    <div class="rounded-circle bg-danger text-white d-flex flex-column align-items-center justify-content-center fw-bold shadow"
                         style="width: 60px; height: 60px; font-size: 0.75rem;" title="@result.BonusName">
                        <span class="fs-5">@result.BonusNumber.ToString("D2")</span>
                        <span style="font-size: 10px; scale: 0.8;">BALL</span>
                    </div>
                </div>
            </div>
        }

        <hr class="my-4" />

        <!-- Button to navigate to Swagger -->
        <div>
            <a href="/swagger" target="_blank" class="btn btn-outline-info btn-sm w-100 py-2">
                📄 Open Swagger API documentation
            </a>
        </div>
    </div>
</div>

@code {
    private LotteryResult? result;

    private void Generate(string type)
    {
        var lottery = LotteryFactory.CreateLottery(type);
        if (lottery != null)
        {
            result = lottery.GenerateTicket(); // Direct call in server memory;
        }
    }
}
